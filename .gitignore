# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Environment
#
# Only `.env` files are ignored. `.env.example` files are committed so that
# every required variable is discoverable from a clean clone.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Test output
# ---------------------------------------------------------------------------
coverage/

# ---------------------------------------------------------------------------
# Expo / React Native
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
web-build/
expo-env.d.ts
.metro-health-check*
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.kotlin/

# Expo generates these when a prebuild / development build is produced.
# They are never committed; `eas build` regenerates them.
/ios/
/android/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
# ---------------------------------------------------------------------------
# API runtime data (never committed)
#
# The tables file is registration data for real products, and its lock file;
# the QR folder is generated artwork. Both are produced by the API and its
# commands, and can always be regenerated or restored from a backup.
# ---------------------------------------------------------------------------
/apps/api/data/
/apps/api/qr-codes/
/apps/api/design-previews/

# ---------------------------------------------------------------------------
# Local tooling and deployment secrets (never committed)
#
# deploy/.env holds the broker password; deploy/mosquitto/passwd holds the
# hashed broker logins. Both are created by hand on the machine that runs the
# stack (see deploy/README.md and hardware/GUIDE-EQUIPE-DUBAI.md).
# ---------------------------------------------------------------------------
.claude/settings.local.json
.impeccable/
deploy/.env
deploy/mosquitto/passwd
