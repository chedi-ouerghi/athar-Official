# ---------------------------------------------------------------------------
# ATHAR API - example environment
#
# Copy to `.env` and adjust. Every value here is a safe, non-secret default:
# the API refuses to start if a value is missing or invalid.
#
#   cp .env.example .env
#
# Real environment variables always take precedence over these files.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Interface the HTTP server binds to.
#
# 0.0.0.0 is required for the API to be reachable from an Android emulator
# (10.0.2.2) or from a physical device on the same network. Use 127.0.0.1 to
# restrict the API to this machine only.
HOST=0.0.0.0

# TCP port the HTTP server listens on.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Grace period, in milliseconds, allowed for in-flight requests when the
# process receives SIGINT or SIGTERM. After this, the process exits anyway.
SHUTDOWN_TIMEOUT_MS=10000

# Which table the API drives: simulation | hardware.
#
# `hardware` is not available yet: the API refuses to start with it until a
# hardware table driver exists. Leave this as `simulation`.
TABLE_MODE=simulation

# Simulator only. Divides simulated drawing durations: 10 turns a 10-minute
# drawing into a 1-minute one. Use a large value for demos and manual testing.
SIMULATION_SPEED_FACTOR=1

# Simulator only. Every Nth drawing fails with a simulated fault; 0 disables it.
SIMULATION_FAULT_EVERY_NTH_JOB=0

# Simulator only. Progress (0 to 1) at which an injected fault occurs.
SIMULATION_FAULT_AT_PROGRESS=0.6

# How many drawing jobs are remembered per table (newest first). Older finished
# jobs are forgotten, together with their idempotency entries. Jobs are held in
# memory and are lost whenever the API restarts.
JOB_HISTORY_LIMIT=20

# JSON file that stores the registered tables. Relative paths are resolved from
# the directory the API runs in (apps/api when started with pnpm). The file and
# its directory are created on first start. In a real deployment this must be on
# persistent storage, and only one API process may run against it.
TABLES_DATA_FILE=./data/tables.json

# JSON files that store accounts (password hashes) and sessions (token hashes).
# Same rules as TABLES_DATA_FILE: persistent storage, one API process only.
# Create the first admin with: pnpm --filter @athar/api admin:create
ACCOUNTS_DATA_FILE=./data/accounts.json
SESSIONS_DATA_FILE=./data/sessions.json

# Origin used to build the link inside each table's QR code: <origin>/t/<tableId>.
# REQUIRED when NODE_ENV=production. Always https, and an origin only: no port,
# path, query or credentials (the app refuses any other link). Leave it commented out in development to get athar://t/<tableId>
# links, which open the app but cannot be scanned by the phone's camera app.
# PUBLIC_LINK_BASE_URL=https://app.athar.example

# Reverse proxies to believe about the client's IP (X-Forwarded-For), which the
# sign-in rate limit uses. A hop count (1 behind one proxy such as Caddy) or a
# comma-separated list of proxy IPs/CIDRs; never true. Unset: trust none.
# TRUST_PROXY=1
