# ---------------------------------------------------------------------------
# ATHAR mobile - example environment
#
# Copy to `.env` and adjust. Values here are safe, non-secret defaults.
#
#   cp .env.example .env
#
# SECURITY: every variable prefixed with EXPO_PUBLIC_ is inlined into the
# JavaScript bundle and is therefore readable by anyone with the app. Never
# place a server credential in this file.
#
# ---------------------------------------------------------------------------

# Full base URL of the ATHAR API, including scheme and port, with no trailing
# slash: e.g. http://192.168.1.20:3000
#
# Leave it commented out to let the app derive a platform-appropriate local
# address from EXPO_PUBLIC_API_PORT:
#
#   Android emulator : http://10.0.2.2:<port>   (10.0.2.2 is the emulator's
#                                                 alias for the host machine)
#   iOS simulator     : http://localhost:<port>
#
# A physical Android or iOS device cannot use either of those: set this
# explicitly to the LAN address of the machine running the API.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000

# Port used to derive the default base URL above. Must match the API's PORT.
EXPO_PUBLIC_API_PORT=3000

# Network timeout, in milliseconds, applied to every API request.
EXPO_PUBLIC_API_TIMEOUT_MS=10000