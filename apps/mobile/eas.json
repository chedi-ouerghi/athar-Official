{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:3000",
        "EXPO_PUBLIC_API_PORT": "3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.athar.example",
        "EXPO_PUBLIC_TABLE_LINK_HOSTS": "",
        "EXPO_PUBLIC_POLL_INTERVAL_MS": "1000"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.athar.example",
        "EXPO_PUBLIC_TABLE_LINK_HOSTS": "",
        "EXPO_PUBLIC_POLL_INTERVAL_MS": "1000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
