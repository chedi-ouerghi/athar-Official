{
  "name": "athar",
  "version": "0.1.0",
  "private": true,
  "description": "ATHAR - smart table mobile and backend monorepo",
  "packageManager": "pnpm@10.12.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream --filter @athar/api --filter @athar/contracts --filter @athar/mobile dev",
    "dev:api": "pnpm --parallel --stream --filter @athar/api --filter @athar/contracts dev",
    "dev:mobile": "pnpm --filter @athar/mobile start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@athar/config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.1"
  }
}
